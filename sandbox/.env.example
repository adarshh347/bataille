# Bataille Clause Sandbox — provider config & API keys (TEMPLATE)
# Copy to `.env` and fill values. The real `.env` is git-ignored.

# --- Default provider for the Generate button ---
# Options: anthropic | gemini | groq
BATAILLE_PROVIDER=gemini

# --- Per-provider model (override if you want; defaults shown) ---
BATAILLE_ANTHROPIC_MODEL=claude-opus-4-7
BATAILLE_GEMINI_MODEL=gemini-2.5-flash
# gemini-2.5-pro requires paid tier (free tier: 0 requests).
# gemini-2.5-flash is on free tier and has the same 1M context window.
BATAILLE_GROQ_MODEL=openai/gpt-oss-120b

# --- API keys — fill the ones you have, leave the rest blank ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Web search (Tavily) — used by researcher's external-web pass ---
# Free tier: 1000 queries/month. Sign up at https://tavily.com
# Without this, external-web passes record a 'no-web-access' warning and degrade
# gracefully to internal-cross-corpus.
TAVILY_API_KEY=

# --- Embeddings (for sqlite-vec, when enabled) ---
# Currently uses Gemini text-embedding-004 via GEMINI_API_KEY above.
BATAILLE_EMBED_MODEL=text-embedding-004

# --- Server ---
PORT=8765
